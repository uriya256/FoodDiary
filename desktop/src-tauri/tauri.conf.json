{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoodDiary",
  "version": "1.30.0",
  "identifier": "com.uriya.fooddiary",
  "build": {
    "frontendDist": "../../app/src/main/assets/www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "יומן אוכל",
        "width": 520,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
